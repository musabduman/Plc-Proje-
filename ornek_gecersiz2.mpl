# ============================================================
# Gecersiz MPL Kaynak Kodu Ornegi 2
# Hata: 'bitir' anahtar kelimesi unutulmus.
# ============================================================

program EksikProgram
basla
    degisken a: sayi;
    a = 15;
    
    eyer (a > 10) ise
        a = a * 2;
    son_eyer;

    # Program 'bitir' ile kapatilmadi!
